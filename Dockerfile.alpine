# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
# check=error=true

ARG BASE_IMAGE=alpine:3.24

FROM ${BASE_IMAGE} AS source
RUN apk add --no-cache gpgv xz
ARG VERSION
ARG SOURCE_SHA256
ADD --checksum=sha256:${SOURCE_SHA256} https://ffmpeg.org/releases/ffmpeg-${VERSION}.tar.xz /src/
ADD https://ffmpeg.org/releases/ffmpeg-${VERSION}.tar.xz.asc /src/
# FFmpeg release signing key, fingerprint FCF9 86EA 15E6 E293 A564 4F10 B432 2F04 D676 58D8
COPY keys/ffmpeg-release.gpg /tmp/ffmpeg-release.gpg
WORKDIR /src
RUN set -eu; \
    gpgv --keyring /tmp/ffmpeg-release.gpg "ffmpeg-${VERSION}.tar.xz.asc" "ffmpeg-${VERSION}.tar.xz"; \
    mkdir ffmpeg; \
    tar -xJf "ffmpeg-${VERSION}.tar.xz" -C ffmpeg --strip-components=1

FROM ${BASE_IMAGE} AS build
SHELL ["/bin/ash", "-eo", "pipefail", "-c"]
RUN apk add --no-cache \
      aom-dev \
      build-base \
      bzip2-dev \
      cmake \
      dav1d-dev \
      fontconfig-dev \
      freetype-dev \
      fribidi-dev \
      harfbuzz-dev \
      lame-dev \
      libass-dev \
      libbluray-dev \
      libdrm-dev \
      libtheora-dev \
      libva-dev \
      libvorbis-dev \
      libvpx-dev \
      libwebp-dev \
      libxml2-dev \
      linux-headers \
      nasm \
      openssl-dev \
      opus-dev \
      pkgconf \
      scanelf \
      soxr-dev \
      svt-av1-dev \
      vidstab-dev \
      x264-dev \
      x265-dev \
      xz-dev \
      zeromq-dev \
      zimg-dev \
      zlib-dev
ARG JOBS

# Alpine's libsrt package lacks the fixes for CVE-2026-55868 and
# CVE-2026-55869, so libsrt is compiled from the upstream release, with
# OpenSSL, upstream's default crypto library. It is installed into /usr/local
# for the FFmpeg build, and its shared library goes into the image.
ARG LIBSRT_VERSION
ARG LIBSRT_SHA256
ADD --checksum=sha256:${LIBSRT_SHA256} https://github.com/Haivision/srt/archive/refs/tags/v${LIBSRT_VERSION}.tar.gz /src/srt.tar.gz
WORKDIR /src/srt
RUN set -eu; \
    tar -xzf /src/srt.tar.gz --strip-components=1; \
    grep -Fqx "set (SRT_VERSION ${LIBSRT_VERSION})" CMakeLists.txt || { echo "the archive is not libsrt ${LIBSRT_VERSION}" >&2; exit 1; }; \
    cmake -S . -B build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DENABLE_APPS=OFF \
      -DENABLE_ENCRYPTION=ON \
      -DUSE_ENCLIB=openssl-evp \
      -DENABLE_SHARED=ON \
      -DENABLE_STATIC=OFF \
      -DENABLE_UNITTESTS=OFF; \
    cmake --build build -j"${JOBS:-$(nproc)}"; \
    cmake --install build --strip; \
    scanelf --needed --nobanner --format '%n#p' "/usr/local/lib/libsrt.so.${LIBSRT_VERSION}" | tr ',' '\n' > /tmp/libsrt-needed; \
    grep -Fq libcrypto.so /tmp/libsrt-needed || { cat /tmp/libsrt-needed >&2; echo "libsrt does not link libcrypto" >&2; exit 1; }; \
    mkdir -p /out/usr/local/lib; \
    cp -P /usr/local/lib/libsrt.so.* /out/usr/local/lib/

COPY --link --from=source /src/ffmpeg /src/ffmpeg
WORKDIR /src/ffmpeg
# Autodetection is off so that only the libraries listed here are linked,
# whatever else the -dev packages pull in.
RUN set -eu; \
    ./configure \
      --prefix=/usr/local \
      --enable-gpl \
      --enable-version3 \
      --enable-shared \
      --disable-static \
      --disable-debug \
      --disable-doc \
      --disable-ffplay \
      --disable-autodetect \
      --enable-bzlib \
      --enable-iconv \
      --enable-lzma \
      --enable-zlib \
      --enable-libaom \
      --enable-libass \
      --enable-libbluray \
      --enable-libdav1d \
      --enable-libdrm \
      --enable-libfontconfig \
      --enable-libfreetype \
      --enable-libfribidi \
      --enable-libharfbuzz \
      --enable-libmp3lame \
      --enable-libopus \
      --enable-libsoxr \
      --enable-libsrt \
      --enable-libsvtav1 \
      --enable-libtheora \
      --enable-libvidstab \
      --enable-libvorbis \
      --enable-libvpx \
      --enable-libwebp \
      --enable-libx264 \
      --enable-libx265 \
      --enable-libxml2 \
      --enable-libzimg \
      --enable-libzmq \
      --enable-openssl \
      --enable-vaapi; \
    make -j"${JOBS:-$(nproc)}"; \
    make install DESTDIR=/out; \
    rm -rf /out/usr/local/include /out/usr/local/lib/pkgconfig /out/usr/local/share/ffmpeg/examples

ARG BASE_IMAGE
ARG VERSION
# runtime-deps lists the so: names the binaries need, minus the libraries
# built here, plus the packages in runtime-deps.alpine.
RUN --mount=type=bind,source=runtime-deps.alpine,target=/tmp/runtime-deps.extra \
    set -eu; \
    meta=/out/usr/local/share/randomcontainers/ffmpeg; \
    mkdir -p "$meta/licenses"; \
    cp COPYING.* LICENSE.md "$meta/licenses/"; \
    cp /src/srt/LICENSE "$meta/licenses/LICENSE.libsrt"; \
    awk '/\/\*/ { c = 1; b = "" } c { b = b $0 "\n" } c && /\*\// { c = 0; if (b ~ /University of Illinois/) { printf "%s", b; f = 1; exit } } END { exit !f }' \
      /src/srt/srtcore/api.cpp > "$meta/licenses/LICENSE.libsrt-udt"; \
    awk '/\/\*/ { c = 1; b = "" } c { b = b $0 "\n" } c && /\*\// { c = 0; if (b ~ /Aladdin Enterprises/) { printf "%s", b; f = 1; exit } } END { exit !f }' \
      /src/srt/srtcore/md5.cpp > "$meta/licenses/LICENSE.libsrt-md5"; \
    awk '{ print } /unlicense\.org/ { f = 1; exit } END { exit !f }' \
      /src/srt/srtcore/atomic.h > "$meta/licenses/LICENSE.libsrt-atomic"; \
    echo "${VERSION}" > "$meta/version"; \
    printf '%s\n' \
      "https://ffmpeg.org/releases/ffmpeg-${VERSION}.tar.xz" \
      "https://ffmpeg.org/releases/ffmpeg-${VERSION}.tar.xz.asc" \
      "https://github.com/Haivision/srt/archive/refs/tags/v${LIBSRT_VERSION}.tar.gz" \
      "https://github.com/randomcontainers/ffmpeg/releases/tag/v${VERSION}" \
      > "$meta/source"; \
    { \
      echo "base: ${BASE_IMAGE}"; \
      echo "compiler: $(cc --version | head -n 1)"; \
      echo "libsrt: ${LIBSRT_VERSION}"; \
      LD_LIBRARY_PATH=/out/usr/local/lib /out/usr/local/bin/ffmpeg -hide_banner -buildconf; \
    } > "$meta/buildinfo"; \
    scanelf --needed --nobanner --format '%n#p' --recursive /out/usr/local | tr ',' '\n' | sort -u > /tmp/needed; \
    grep -Eq '^libsrt\.so\.' /tmp/needed || { echo "FFmpeg does not link libsrt" >&2; exit 1; }; \
    while read -r so; do \
      if [ -n "$so" ] && [ -z "$(find /out -name "$so" -print -quit)" ]; then echo "so:$so"; fi; \
    done < /tmp/needed > /tmp/elf-deps; \
    test -s /tmp/elf-deps; \
    sort -u /tmp/elf-deps /tmp/runtime-deps.extra > "$meta/runtime-deps"

FROM ${BASE_IMAGE} AS slim
COPY --link --from=build /out/usr/local/ /usr/local/
RUN set -eu; \
    xargs apk add --no-cache ca-certificates tini < /usr/local/share/randomcontainers/ffmpeg/runtime-deps; \
    addgroup -g 1000 app; \
    adduser -D -u 1000 -G app app; \
    install -d -m 1777 /work /cache
ENV LANG=C.UTF-8 XDG_CACHE_HOME=/cache
WORKDIR /work
USER 1000:1000
ENTRYPOINT ["tini", "--", "ffmpeg"]
CMD ["-version"]
