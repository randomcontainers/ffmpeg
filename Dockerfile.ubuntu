# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
# check=error=true

ARG BASE_IMAGE=ubuntu:26.04

FROM ${BASE_IMAGE} AS source
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends gpgv xz-utils \
 && rm -rf /var/lib/apt/lists/*
ARG VERSION
ARG SOURCE_SHA256
ADD --checksum=sha256:${SOURCE_SHA256} https://ffmpeg.org/releases/ffmpeg-${VERSION}.tar.xz /src/
ADD https://ffmpeg.org/releases/ffmpeg-${VERSION}.tar.xz.asc /src/
# FFmpeg release signing key, fingerprint FCF9 86EA 15E6 E293 A564 4F10 B432 2F04 D676 58D8
COPY keys/ffmpeg-release.gpg /tmp/ffmpeg-release.gpg
WORKDIR /src
RUN set -eu; \
    gpgv --keyring /tmp/ffmpeg-release.gpg "ffmpeg-${VERSION}.tar.xz.asc" "ffmpeg-${VERSION}.tar.xz"; \
    mkdir ffmpeg; \
    tar -xJf "ffmpeg-${VERSION}.tar.xz" -C ffmpeg --strip-components=1

FROM ${BASE_IMAGE} AS build
ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-eo", "pipefail", "-c"]
# The base image's packages are recorded before anything is installed, so that
# runtime-deps can leave them out. Every image that installs runtime-deps is
# built on the same base.
RUN dpkg-query -W -f '${Package}\n' | sort -u > /tmp/base-packages \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential \
      cmake \
      libaom-dev \
      libass-dev \
      libbluray-dev \
      libbz2-dev \
      libdav1d-dev \
      libdrm-dev \
      libfontconfig-dev \
      libfreetype-dev \
      libfribidi-dev \
      libgnutls28-dev \
      libharfbuzz-dev \
      liblzma-dev \
      libmp3lame-dev \
      libopus-dev \
      libsoxr-dev \
      libssl-dev \
      libsvtav1enc-dev \
      libtheora-dev \
      libva-dev \
      libvidstab-dev \
      libvorbis-dev \
      libvpx-dev \
      libwebp-dev \
      libx264-dev \
      libx265-dev \
      libxml2-dev \
      libzimg-dev \
      libzmq3-dev \
      nasm \
      pkgconf \
      zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*
ARG JOBS

# Ubuntu ships the libsrt fixes for CVE-2026-55868 and CVE-2026-55869 only
# through Ubuntu Pro, so libsrt is compiled from the upstream release, with
# OpenSSL, upstream's default crypto library. It is installed into /usr/local
# for the FFmpeg build, and its shared library goes into the image.
ARG LIBSRT_VERSION
ARG LIBSRT_SHA256
ADD --checksum=sha256:${LIBSRT_SHA256} https://github.com/Haivision/srt/archive/refs/tags/v${LIBSRT_VERSION}.tar.gz /src/srt.tar.gz
WORKDIR /src/srt
RUN set -eu; \
    tar -xzf /src/srt.tar.gz --strip-components=1; \
    grep -Fqx "set (SRT_VERSION ${LIBSRT_VERSION})" CMakeLists.txt || { echo "the archive is not libsrt ${LIBSRT_VERSION}" >&2; exit 1; }; \
    cmake -S . -B build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DCMAKE_INSTALL_LIBDIR=lib \
      -DENABLE_APPS=OFF \
      -DENABLE_ENCRYPTION=ON \
      -DUSE_ENCLIB=openssl-evp \
      -DENABLE_SHARED=ON \
      -DENABLE_STATIC=OFF \
      -DENABLE_UNITTESTS=OFF; \
    cmake --build build -j"${JOBS:-$(nproc)}"; \
    cmake --install build --strip; \
    readelf -d "/usr/local/lib/libsrt.so.${LIBSRT_VERSION}" > /tmp/libsrt-dynamic; \
    grep -Fq 'Shared library: [libcrypto.so' /tmp/libsrt-dynamic || { cat /tmp/libsrt-dynamic >&2; echo "libsrt does not link libcrypto" >&2; exit 1; }; \
    mkdir -p /out/usr/local/lib; \
    cp -P /usr/local/lib/libsrt.so.* /out/usr/local/lib/

COPY --link --from=source /src/ffmpeg /src/ffmpeg
WORKDIR /src/ffmpeg
# Autodetection is off so that only the libraries listed here are linked,
# whatever else the -dev packages pull in.
RUN set -eu; \
    ./configure \
      --prefix=/usr/local \
      --enable-gpl \
      --enable-version3 \
      --enable-shared \
      --disable-static \
      --disable-debug \
      --disable-doc \
      --disable-ffplay \
      --disable-autodetect \
      --enable-bzlib \
      --enable-iconv \
      --enable-lzma \
      --enable-zlib \
      --enable-gnutls \
      --enable-libaom \
      --enable-libass \
      --enable-libbluray \
      --enable-libdav1d \
      --enable-libdrm \
      --enable-libfontconfig \
      --enable-libfreetype \
      --enable-libfribidi \
      --enable-libharfbuzz \
      --enable-libmp3lame \
      --enable-libopus \
      --enable-libsoxr \
      --enable-libsrt \
      --enable-libsvtav1 \
      --enable-libtheora \
      --enable-libvidstab \
      --enable-libvorbis \
      --enable-libvpx \
      --enable-libwebp \
      --enable-libx264 \
      --enable-libx265 \
      --enable-libxml2 \
      --enable-libzimg \
      --enable-libzmq \
      --enable-vaapi; \
    make -j"${JOBS:-$(nproc)}"; \
    make install DESTDIR=/out; \
    rm -rf /out/usr/local/include /out/usr/local/lib/pkgconfig /out/usr/local/share/ffmpeg/examples

ARG BASE_IMAGE
ARG VERSION
# runtime-deps lists the packages that own the libraries the binaries load,
# minus the base image's packages, plus the packages in runtime-deps.ubuntu.
RUN --mount=type=bind,source=runtime-deps.ubuntu,target=/tmp/runtime-deps.extra \
    set -eu; \
    meta=/out/usr/local/share/randomcontainers/ffmpeg; \
    mkdir -p "$meta/licenses"; \
    cp COPYING.* LICENSE.md "$meta/licenses/"; \
    cp /src/srt/LICENSE "$meta/licenses/LICENSE.libsrt"; \
    awk '/\/\*/ { c = 1; b = "" } c { b = b $0 "\n" } c && /\*\// { c = 0; if (b ~ /University of Illinois/) { printf "%s", b; f = 1; exit } } END { exit !f }' \
      /src/srt/srtcore/api.cpp > "$meta/licenses/LICENSE.libsrt-udt"; \
    awk '/\/\*/ { c = 1; b = "" } c { b = b $0 "\n" } c && /\*\// { c = 0; if (b ~ /Aladdin Enterprises/) { printf "%s", b; f = 1; exit } } END { exit !f }' \
      /src/srt/srtcore/md5.cpp > "$meta/licenses/LICENSE.libsrt-md5"; \
    awk '{ print } /unlicense\.org/ { f = 1; exit } END { exit !f }' \
      /src/srt/srtcore/atomic.h > "$meta/licenses/LICENSE.libsrt-atomic"; \
    echo "${VERSION}" > "$meta/version"; \
    printf '%s\n' \
      "https://ffmpeg.org/releases/ffmpeg-${VERSION}.tar.xz" \
      "https://ffmpeg.org/releases/ffmpeg-${VERSION}.tar.xz.asc" \
      "https://github.com/Haivision/srt/archive/refs/tags/v${LIBSRT_VERSION}.tar.gz" \
      "https://github.com/randomcontainers/ffmpeg/releases/tag/v${VERSION}" \
      > "$meta/source"; \
    { \
      echo "base: ${BASE_IMAGE}"; \
      echo "compiler: $(cc --version | head -n 1)"; \
      echo "libsrt: ${LIBSRT_VERSION}"; \
      LD_LIBRARY_PATH=/out/usr/local/lib /out/usr/local/bin/ffmpeg -hide_banner -buildconf; \
    } > "$meta/buildinfo"; \
    find /out/usr/local -type f \( -perm -u+x -o -name '*.so*' \) -print0 \
      | xargs -0 env LD_LIBRARY_PATH=/out/usr/local/lib ldd > /tmp/ldd 2>&1 || true; \
    if grep 'not found' /tmp/ldd; then exit 1; fi; \
    grep -E '^[[:space:]]+libsrt\.so\.' /tmp/ldd > /tmp/ldd-srt || { echo "FFmpeg does not link libsrt" >&2; exit 1; }; \
    if grep -Fv '=> /out/usr/local/lib/libsrt.so.' /tmp/ldd-srt; then echo "FFmpeg loads a libsrt other than the one built here" >&2; exit 1; fi; \
    awk '$2 == "=>" && $3 ~ /^\// && $3 !~ /^\/out\// { print $3 }' /tmp/ldd | sort -u > /tmp/libs; \
    test -s /tmp/libs; \
    while read -r lib; do \
      real="$(readlink -f "$lib")"; \
      dpkg-query --search "*${real#/usr}"; \
    done < /tmp/libs | cut -d: -f1 | sort -u | comm -23 - /tmp/base-packages > /tmp/elf-deps; \
    sort -u /tmp/elf-deps /tmp/runtime-deps.extra > "$meta/runtime-deps"

FROM ${BASE_IMAGE} AS slim
ARG DEBIAN_FRONTEND=noninteractive
COPY --link --from=build /out/usr/local/ /usr/local/
RUN set -eu; \
    apt-get update; \
    xargs apt-get install -y --no-install-recommends ca-certificates tini < /usr/local/share/randomcontainers/ffmpeg/runtime-deps; \
    rm -rf /var/lib/apt/lists/*; \
    ldconfig; \
    install -d -m 1777 /work /cache
ENV LANG=C.UTF-8 XDG_CACHE_HOME=/cache
WORKDIR /work
USER 1000:1000
ENTRYPOINT ["tini", "--", "ffmpeg"]
CMD ["-version"]
